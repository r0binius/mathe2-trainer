          </mxGeometry>
        </mxCell>
        <mxCell id="ls_note" value="&lt;b&gt;From every state&lt;/b&gt;&lt;br&gt;opened → as from &lt;i&gt;waiting&lt;/i&gt;, with openings + 1 and an empty query.&lt;br&gt;searched → only the query changes.&lt;br&gt;menusRead for another opening, or outside &lt;i&gt;loading&lt;/i&gt; → ignored." parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;">
