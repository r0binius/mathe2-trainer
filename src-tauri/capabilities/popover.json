{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "Capability for the popover",
  "windows": ["popover"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-keymap",
    "allow-get-settings",
    "allow-dismiss-popover",
    "allow-ask-for-menu-access",
    "allow-read-menu-shortcuts",
    "log:allow-log"
  ]
}
