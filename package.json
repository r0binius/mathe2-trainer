{
  "name": "mathe2-trainer",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "mathjax-full": "^3.2.1",
    "pinia": "^4.0.3",
    "ts-fsrs": "^5.4.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.148.0"
  },
  "description": "Exam trainer for Mathematik 2: definitions, theorems, true-or-false and problems, with spaced repetition.",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
