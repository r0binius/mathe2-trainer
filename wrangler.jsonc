{
  "name": "mathe2-trainer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The built page, served by the worker; only /api/* runs the worker code first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  // The progress is stored under the hash of a sync key, which the settings page generates. The
  // namespace is pinned by id, so a deploy can never swap it for an empty one.
  "kv_namespaces": [{ "binding": "PROGRESS", "id": "b6a10fddd7ad4aa4b4c1a7d9b69ba2a6" }],
}
